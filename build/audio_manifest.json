    {
      "beat_id": "s01_b04",
      "audio_file": "build/audio/s01_b04.wav",
      "duration_seconds": 2.581,
      "subtitle": "और सीधे एक अँधेरे नाले में पहुँच जाती है।"
    },
    {
      "beat_id": "s01_b05",
      "audio_file": "build/audio/s01_b05.wav",
      "duration_seconds": 2.773,
      "subtitle": "तभी अंदर से एक अजीब जोकर दिखाई देता है।"
