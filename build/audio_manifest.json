{
  "total_duration": 64.32,
  "beats": [
    {
      "beat_id": "s01_b01",
      "audio_file": "build/audio/s01_b01.wav",
      "duration_seconds": 5.312,
      "subtitle": "अगर कोई अजनबी आपको कल की खुशी आज ही दे दे… तो क्या आप उस पर भरोसा करेंगे?"
    },
    {
      "beat_id": "s01_b02",
      "audio_file": "build/audio/s01_b02.wav",
      "duration_seconds": 4.16,
      "subtitle": "एक छोटे से गाँव में, एक किसान हर दिन अपनी किस्मत को कोसता था।"
    },
    {
      "beat_id": "s01_b03",
      "audio_file": "build/audio/s01_b03.wav",
      "duration_seconds": 2.304,
      "subtitle": "एक दिन वहाँ एक बूढ़ा मुसाफ़िर आया।"
    },
    {
      "beat_id": "s01_b04",
      "audio_file": "build/audio/s01_b04.wav",
      "duration_seconds": 3.349,
      "subtitle": "उसने किसान की हथेली पर एक अजीब-सा बीज रख दिया।"
    },
    {
      "beat_id": "s01_b05",
      "audio_file": "build/audio/s01_b05.wav",
      "duration_seconds": 3.435,
      "subtitle": "मुसाफ़िर बोला, 'इसे बोना… कल तुम्हें इसका फल मिलेगा।'"
    },
    {
      "beat_id": "s02_b01",
      "audio_file": "build/audio/s02_b01.wav",
      "duration_seconds": 2.88,
      "subtitle": "किसान हँसा, लेकिन फिर भी उसने बीज बो दिया।"
    },
    {
      "beat_id": "s02_b02",
      "audio_file": "build/audio/s02_b02.wav",
      "duration_seconds": 3.285,
      "subtitle": "उसने थोड़ा पानी डाला… और रात होने का इंतज़ार किया।"
    },
    {
      "beat_id": "s02_b03",
      "audio_file": "build/audio/s02_b03.wav",
      "duration_seconds": 1.813,
      "subtitle": "सुबह वह दौड़कर बाहर आया…"
    },
    {
      "beat_id": "s02_b04",
      "audio_file": "build/audio/s02_b04.wav",
      "duration_seconds": 2.176,
      "subtitle": "लेकिन वहाँ तो कुछ भी नहीं उगा था!"
    },
    {
      "beat_id": "s02_b05",
      "audio_file": "build/audio/s02_b05.wav",
      "duration_seconds": 2.496,
      "subtitle": "वह गुस्से में बीज को बेकार समझने लगा।"
    },
    {
      "beat_id": "s03_b01",
      "audio_file": "build/audio/s03_b01.wav",
      "duration_seconds": 3.541,
      "subtitle": "तभी उसे याद आया… मुसाफ़िर ने कहा था, कल फल मिलेगा।"
    },
    {
      "beat_id": "s03_b02",
      "audio_file": "build/audio/s03_b02.wav",
      "duration_seconds": 4.544,
      "subtitle": "वह बूढ़े आदमी को ढूँढ़ने दौड़ा… पर गाँव में कोई उसे जानता ही नहीं था।"
    },
    {
      "beat_id": "s03_b03",
      "audio_file": "build/audio/s03_b03.wav",
      "duration_seconds": 2.773,
      "subtitle": "शाम तक थककर वह उसी कुएँ के पास लौट आया।"
    },
    {
      "beat_id": "s03_b04",
      "audio_file": "build/audio/s03_b04.wav",
      "duration_seconds": 3.84,
      "subtitle": "तभी उसकी नज़र मिट्टी पर पड़ी… वहाँ एक नन्हा अंकुर निकला था!"
    },
    {
      "beat_id": "s03_b05",
      "audio_file": "build/audio/s03_b05.wav",
      "duration_seconds": 3.648,
      "subtitle": "वह मुस्कुराया… क्योंकि उसे पहली बार कल पर भरोसा हुआ था।"
    },
    {
      "beat_id": "s04_b01",
      "audio_file": "build/audio/s04_b01.wav",
      "duration_seconds": 2.752,
      "subtitle": "कहते हैं, उस बीज ने अगले दिन फल नहीं दिया…"
    },
    {
      "beat_id": "s04_b02",
      "audio_file": "build/audio/s04_b02.wav",
      "duration_seconds": 1.749,
      "subtitle": "न ही उसके बाद वाले दिन…"
    },
    {
      "beat_id": "s04_b03",
      "audio_file": "build/audio/s04_b03.wav",
      "duration_seconds": 2.709,
      "subtitle": "लेकिन किसान ने पानी देना बंद नहीं किया।"
    },
    {
      "beat_id": "s04_b04",
      "audio_file": "build/audio/s04_b04.wav",
      "duration_seconds": 3.861,
      "subtitle": "कुछ हफ्तों बाद, उस छोटे पौधे पर पहला सुनहरा फल लगा।"
    },
    {
      "beat_id": "s04_b05",
      "audio_file": "build/audio/s04_b05.wav",
      "duration_seconds": 3.691,
      "subtitle": "किसान समझ गया… चमत्कार बीज में नहीं, उसके धैर्य में था।"
    }
  ]
}