    {
      "beat_id": "s06_b04",
      "audio_file": "build/audio/s06_b04.wav",
      "duration_seconds": 2.752,
      "subtitle": "क्योंकि अब बच्चे उससे डरना बंद कर चुके होते हैं।"
    },
    {
      "beat_id": "s06_b05",
      "audio_file": "build/audio/s06_b05.wav",
      "duration_seconds": 3.115,
      "subtitle": "वे मिलकर उसे पीछे हटने पर मजबूर कर देते हैं।"
    },
    {
      "beat_id": "s06_b06",
      "audio_file": "build/audio/s06_b06.wav",
      "duration_seconds": 3.008,
      "subtitle": "बिल अपने दोस्तों के साथ बेवर्ली को बचा लेता है।"
    },
    {
      "beat_id": "s06_b07",
      "audio_file": "build/audio/s06_b07.wav",
      "duration_seconds": 3.008,
      "subtitle": "और सभी उस खौफनाक जगह से बाहर निकल आते हैं।"
    },
    {
      "beat_id": "s07_b01",
      "audio_file": "build/audio/s07_b01.wav",
      "duration_seconds": 3.285,
      "subtitle": "लेकिन जाने से पहले सातों दोस्त खून की कसम खाते हैं।"
    },
    {
      "beat_id": "s07_b02",
      "audio_file": "build/audio/s07_b02.wav",
      "duration_seconds": 3.029,
      "subtitle": "अगर वह जोकर वापस आया, तो वे फिर साथ लड़ेंगे।"
    },
    {
      "beat_id": "s07_b03",
      "audio_file": "build/audio/s07_b03.wav",
      "duration_seconds": 3.136,
      "subtitle": "क्योंकि डेरी का यह डर अभी पूरी तरह खत्म नहीं हुआ था।"
    }
  ]
}