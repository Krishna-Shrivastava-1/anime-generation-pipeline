{
  "total_duration": 119.083,
  "beats": [
    {
      "beat_id": "s01_b01",
      "audio_file": "build/audio/s01_b01.wav",
      "duration_seconds": 2.603,
      "subtitle": "राजा वीर के राज्य में सब कुछ खुशहाल था।"
    },
    {
      "beat_id": "s01_b02",
      "audio_file": "build/audio/s01_b02.wav",
      "duration_seconds": 2.304,
      "subtitle": "लेकिन महल में एक अजीब बात होने लगी।"
    },
    {
      "beat_id": "s01_b03",
      "audio_file": "build/audio/s01_b03.wav",
      "duration_seconds": 2.304,
      "subtitle": "हर रात रसोई से अनाज गायब हो जाता।"
    },
    {
      "beat_id": "s01_b04",
      "audio_file": "build/audio/s01_b04.wav",
      "duration_seconds": 2.261,
      "subtitle": "पहले सबने इसे छोटी चोरी समझा।"
    },
    {
      "beat_id": "s01_b05",
      "audio_file": "build/audio/s01_b05.wav",
      "duration_seconds": 2.475,
      "subtitle": "फिर एक रात रानी तारा को एक पर्ची मिली।"
    },
    {
      "beat_id": "s01_b06",
      "audio_file": "build/audio/s01_b06.wav",
      "duration_seconds": 2.197,
      "subtitle": "उस पर लिखा था, महल के नीचे देखिए।"
    },
    {
      "beat_id": "s01_b07",
      "audio_file": "build/audio/s01_b07.wav",
      "duration_seconds": 1.941,
      "subtitle": "तारा ने तुरंत राजा को बुलाया।"
    },
    {
      "beat_id": "s01_b08",
      "audio_file": "build/audio/s01_b08.wav",
      "duration_seconds": 2.048,
      "subtitle": "राजा ने पर्ची पढ़ी और चौंक गया।"
    },
    {
      "beat_id": "s02_b01",
      "audio_file": "build/audio/s02_b01.wav",
      "duration_seconds": 3.328,
      "subtitle": "दोनों ने रात में रसोई की निगरानी करने का फैसला किया।"
    },
    {
      "beat_id": "s02_b02",
      "audio_file": "build/audio/s02_b02.wav",
      "duration_seconds": 2.325,
      "subtitle": "आधी रात को वे रसोई के पास छिप गए।"
    },
    {
      "beat_id": "s02_b03",
      "audio_file": "build/audio/s02_b03.wav",
      "duration_seconds": 2.197,
      "subtitle": "तभी एक साया धीरे-धीरे अंदर आया।"
    },
    {
      "beat_id": "s02_b04",
      "audio_file": "build/audio/s02_b04.wav",
      "duration_seconds": 1.941,
      "subtitle": "उसके हाथ में महल की चाबी थी।"
    },
    {
      "beat_id": "s02_b05",
      "audio_file": "build/audio/s02_b05.wav",
      "duration_seconds": 1.685,
      "subtitle": "उसने अनाज की बोरी उठाई।"
    },
    {
      "beat_id": "s02_b06",
      "audio_file": "build/audio/s02_b06.wav",
      "duration_seconds": 1.856,
      "subtitle": "और दीवार की तरफ बढ़ने लगा।"
    },
    {
      "beat_id": "s02_b07",
      "audio_file": "build/audio/s02_b07.wav",
      "duration_seconds": 1.835,
      "subtitle": "उसने कमल के निशान को दबाया।"
    },
    {
      "beat_id": "s02_b08",
      "audio_file": "build/audio/s02_b08.wav",
      "duration_seconds": 1.877,
      "subtitle": "और दीवार का एक हिस्सा खुल गया।"
    },
    {
      "beat_id": "s02_b09",
      "audio_file": "build/audio/s02_b09.wav",
      "duration_seconds": 2.197,
      "subtitle": "राजा और रानी ने एक-दूसरे को देखा।"
    },
    {
      "beat_id": "s03_b01",
      "audio_file": "build/audio/s03_b01.wav",
      "duration_seconds": 2.24,
      "subtitle": "वे चुपचाप उस गुप्त रास्ते में घुस गए।"
    },
    {
      "beat_id": "s03_b02",
      "audio_file": "build/audio/s03_b02.wav",
      "duration_seconds": 2.603,
      "subtitle": "रास्ता महल के नीचे बहुत दूर तक जाता था।"
    },
    {
      "beat_id": "s03_b03",
      "audio_file": "build/audio/s03_b03.wav",
      "duration_seconds": 2.261,
      "subtitle": "आगे उन्हें पैरों के ताज़ा निशान दिखे।"
    },
    {
      "beat_id": "s03_b04",
      "audio_file": "build/audio/s03_b04.wav",
      "duration_seconds": 2.325,
      "subtitle": "रानी ने राजा को रुकने का इशारा किया।"
