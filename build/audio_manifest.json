{
  "total_duration": 88.405,
  "beats": [
    {
      "beat_id": "s01_b01",
      "audio_file": "build/audio/s01_b01.wav",
      "duration_seconds": 3.84,
      "subtitle": "पैसे कमाने हैं, लेकिन समझ नहीं आ रहा कि शुरुआत कहाँ से करें?"
    },
    {
      "beat_id": "s01_b02",
      "audio_file": "build/audio/s01_b02.wav",
      "duration_seconds": 5.099,
      "subtitle": "तो चलो, जानते हैं पैसे कमाने के पाँच ऐसे तरीके, जिनसे तुम शुरुआत कर सकते हो।"
    },
    {
      "beat_id": "s02_b01",
      "audio_file": "build/audio/s02_b01.wav",
      "duration_seconds": 3.008,
      "subtitle": "पहला तरीका है अपनी स्किल बेचकर पैसे कमाना।"
    },
    {
      "beat_id": "s02_b02",
      "audio_file": "build/audio/s02_b02.wav",
      "duration_seconds": 3.733,
      "subtitle": "जैसे वीडियो एडिटिंग, ग्राफिक डिजाइनिंग या वेबसाइट बनाना।"
    },
    {
      "beat_id": "s02_b03",
      "audio_file": "build/audio/s02_b03.wav",
      "duration_seconds": 3.627,
      "subtitle": "इन सेवाओं को छोटे बिजनेस या ऑनलाइन क्लाइंट्स को ऑफर करो।"
    },
    {
      "beat_id": "s02_b04",
      "audio_file": "build/audio/s02_b04.wav",
      "duration_seconds": 4.267,
      "subtitle": "शुरुआत में एक छोटी स्किल सीखो, काम के नमूने बनाओ और क्लाइंट ढूँढो।"
    },
    {
      "beat_id": "s03_b01",
      "audio_file": "build/audio/s03_b01.wav",
      "duration_seconds": 2.453,
      "subtitle": "दूसरा तरीका है ऑनलाइन ट्यूशन देना।"
    },
    {
      "beat_id": "s03_b02",
      "audio_file": "build/audio/s03_b02.wav",
      "duration_seconds": 3.925,
      "subtitle": "अगर तुम्हें मैथ्स, इंग्लिश, कोडिंग या कोई सब्जेक्ट अच्छे से आता है,"
    },
    {
      "beat_id": "s03_b03",
      "audio_file": "build/audio/s03_b03.wav",
      "duration_seconds": 3.264,
      "subtitle": "तो बच्चों या दूसरे स्टूडेंट्स को ऑनलाइन पढ़ा सकते हो।"
    },
    {
      "beat_id": "s03_b04",
      "audio_file": "build/audio/s03_b04.wav",
      "duration_seconds": 4.565,
      "subtitle": "एक विषय चुनो, अपनी टाइमिंग तय करो और पहले कुछ स्टूडेंट्स से शुरुआत करो।"
    },
    {
      "beat_id": "s04_b01",
      "audio_file": "build/audio/s04_b01.wav",
      "duration_seconds": 2.048,
      "subtitle": "तीसरा तरीका है कंटेंट बनाना।"
    },
    {
      "beat_id": "s04_b02",
      "audio_file": "build/audio/s04_b02.wav",
      "duration_seconds": 5.312,
      "subtitle": "यूट्यूब, इंस्टाग्राम या किसी प्लेटफॉर्म पर ऐसी चीजें शेयर करो, जो लोगों के काम आएँ।"
    },
    {
      "beat_id": "s04_b03",
      "audio_file": "build/audio/s04_b03.wav",
      "duration_seconds": 4.096,
      "subtitle": "शुरुआत में व्यूज़ के पीछे मत भागो, लगातार अच्छी वीडियो बनाओ।"
    },
    {
      "beat_id": "s04_b04",
      "audio_file": "build/audio/s04_b04.wav",
      "duration_seconds": 4.309,
      "subtitle": "आगे चलकर कमाई विज्ञापनों, ब्रांड डील्स और अपने प्रोडक्ट्स से हो सकती है।"
    },
    {
      "beat_id": "s05_b01",
      "audio_file": "build/audio/s05_b01.wav",
      "duration_seconds": 2.517,
      "subtitle": "चौथा तरीका है डिजिटल प्रोडक्ट्स बेचना।"
    },
    {
      "beat_id": "s05_b02",
      "audio_file": "build/audio/s05_b02.wav",
      "duration_seconds": 2.837,
      "subtitle": "जैसे ई-बुक, नोट्स, टेम्पलेट्स या डिजाइन फाइल्स।"
    },
    {
      "beat_id": "s05_b03",
      "audio_file": "build/audio/s05_b03.wav",
      "duration_seconds": 4.267,
      "subtitle": "एक बार अच्छा प्रोडक्ट बनाओ, फिर उसे ऑनलाइन कई लोगों को बेच सकते हो।"
    },
    {
      "beat_id": "s06_b01",
      "audio_file": "build/audio/s06_b01.wav",
      "duration_seconds": 3.349,
      "subtitle": "पाँचवाँ तरीका है रीसेलिंग या छोटा ऑनलाइन बिजनेस।"
    },
    {
      "beat_id": "s06_b02",
      "audio_file": "build/audio/s06_b02.wav",
      "duration_seconds": 3.008,
      "subtitle": "ऐसे प्रोडक्ट चुनो जिनकी लोगों को सच में जरूरत हो।"
    },
    {
      "beat_id": "s06_b03",
      "audio_file": "build/audio/s06_b03.wav",
      "duration_seconds": 4.117,
      "subtitle": "फिर उनकी कीमत, डिलीवरी और अपना मुनाफा सही से समझकर बेचो।"
    },
    {
      "beat_id": "s07_b01",
      "audio_file": "build/audio/s07_b01.wav",
      "duration_seconds": 4.245,
      "subtitle": "लेकिन एक बात याद रखना, जल्दी अमीर बनाने वाले वादों से बचना।"
    },
    {
      "beat_id": "s07_b02",
      "audio_file": "build/audio/s07_b02.wav",
      "duration_seconds": 3.712,
      "subtitle": "किसी भी काम में समय, मेहनत और सीखने की जरूरत होती है।"
    },
    {
      "beat_id": "s07_b03",
      "audio_file": "build/audio/s07_b03.wav",
      "duration_seconds": 3.371,
      "subtitle": "तो इनमें से एक तरीका चुनो और आज ही पहला कदम उठाओ।"
    },
    {
      "beat_id": "s07_b04",
      "audio_file": "build/audio/s07_b04.wav",
      "duration_seconds": 3.435,
      "subtitle": "और कमेंट में बताओ, तुम कौन सा तरीका आज़माने वाले हो?"
    }
  ]
}