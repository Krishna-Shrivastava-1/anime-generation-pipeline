    {
      "beat_id": "s04_b04",
      "audio_file": "build/audio/s04_b04.wav",
      "duration_seconds": 3.051,
      "subtitle": "उसमें लिखा था कि पड़ोसी राज्य ने अनाज चुराया है।"
