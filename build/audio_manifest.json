    {
      "beat_id": "s05_b04",
      "audio_file": "build/audio/s05_b04.wav",
      "duration_seconds": 3.435,
      "subtitle": "वहाँ उन्हें गायब हुए बच्चे हवा में तैरते दिखाई देते हैं।"
    },
    {
      "beat_id": "s05_b05",
      "audio_file": "build/audio/s05_b05.wav",
      "duration_seconds": 2.176,
      "subtitle": "उनमें बेवर्ली भी फँसी हुई होती है।"
