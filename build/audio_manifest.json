    {
      "beat_id": "s03_b04",
      "audio_file": "build/audio/s03_b04.wav",
      "duration_seconds": 3.072,
      "subtitle": "लेकिन उसके पिता को वहाँ कुछ भी दिखाई नहीं देता।"
