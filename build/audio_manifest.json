      "subtitle": "जहाँ छोटा जॉर्जी बारिश में खेल रहा होता है।"
    },
    {
      "beat_id": "s01_b03",
      "audio_file": "build/audio/s01_b03.wav",
      "duration_seconds": 2.112,
      "subtitle": "उसकी नाव पानी में बहने लगती है।"
