    {
      "beat_id": "s02_b06",
      "audio_file": "build/audio/s02_b06.wav",
      "duration_seconds": 2.901,
      "subtitle": "बाद में बेन, माइक और बेवर्ली भी उनसे जुड़ते हैं।"
