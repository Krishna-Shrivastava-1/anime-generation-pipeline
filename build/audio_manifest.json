    {
      "beat_id": "s05_b06",
      "audio_file": "build/audio/s05_b06.wav",
      "duration_seconds": 4.395,
      "subtitle": "बिल को वहाँ अपने छोटे भाई जैसा दिखने वाला बच्चा भी दिखाई देता है।"
    },
    {
      "beat_id": "s05_b07",
      "audio_file": "build/audio/s05_b07.wav",
      "duration_seconds": 3.584,
      "subtitle": "लेकिन वह समझ जाता है कि यह सिर्फ उस जोकर का धोखा है।"
    },
    {
      "beat_id": "s05_b08",
      "audio_file": "build/audio/s05_b08.wav",
      "duration_seconds": 3.776,
      "subtitle": "अब सातों दोस्त मिलकर उस राक्षस से लड़ने का फैसला करते हैं।"
    },
    {
      "beat_id": "s06_b01",
      "audio_file": "build/audio/s06_b01.wav",
      "duration_seconds": 3.456,
      "subtitle": "इस बार बच्चे भागते नहीं, बल्कि उसका सामना करते हैं।"
    },
    {
      "beat_id": "s06_b02",
      "audio_file": "build/audio/s06_b02.wav",
      "duration_seconds": 3.072,
      "subtitle": "रिची, एडी और बाकी दोस्त भी उस पर हमला कर देते हैं।"
    },
    {
      "beat_id": "s06_b03",
      "audio_file": "build/audio/s06_b03.wav",
      "duration_seconds": 2.261,
      "subtitle": "धीरे-धीरे वह कमजोर पड़ने लगता है।"
