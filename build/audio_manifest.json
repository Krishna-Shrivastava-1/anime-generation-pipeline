    {
      "beat_id": "s04_b04",
      "audio_file": "build/audio/s04_b04.wav",
      "duration_seconds": 2.56,
      "subtitle": "और वही जोकर उन पर हमला करने लगता है।"
    },
    {
      "beat_id": "s04_b05",
      "audio_file": "build/audio/s04_b05.wav",
      "duration_seconds": 2.368,
      "subtitle": "सभी किसी तरह वहाँ से भाग निकलते हैं।"
