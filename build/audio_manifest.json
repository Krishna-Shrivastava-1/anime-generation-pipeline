      "duration_seconds": 3.179,
      "subtitle": "कहानी शुरू होती है डेरी नाम के एक छोटे शहर से।"
    },
    {
      "beat_id": "s01_b02",
      "audio_file": "build/audio/s01_b02.wav",
      "duration_seconds": 3.328,
      "subtitle": "जहाँ एक दिन छोटा जॉर्जी बारिश में खेलने निकलता है।"
    },
    {
      "beat_id": "s01_b03",
      "audio_file": "build/audio/s01_b03.wav",
      "duration_seconds": 3.115,
      "subtitle": "लेकिन उसकी कागज़ की नाव पानी में बहने लगती है।"
    },
    {
      "beat_id": "s01_b04",
      "audio_file": "build/audio/s01_b04.wav",
      "duration_seconds": 3.093,
      "subtitle": "और सीधे एक अँधेरे नाले के अंदर पहुँच जाती है।"
    },
    {
      "beat_id": "s01_b05",
      "audio_file": "build/audio/s01_b05.wav",
      "duration_seconds": 3.648,
      "subtitle": "तभी अँधेरे के अंदर से एक डरावना जोकर दिखाई देता है।"
    },
    {
      "beat_id": "s01_b06",
      "audio_file": "build/audio/s01_b06.wav",
      "duration_seconds": 2.624,
      "subtitle": "वह जॉर्जी को नाव लौटाने का लालच देता है।"
    },
    {
      "beat_id": "s01_b07",
      "audio_file": "build/audio/s01_b07.wav",
      "duration_seconds": 2.539,
      "subtitle": "लेकिन अचानक वह उस पर हमला कर देता है।"
    },
    {
      "beat_id": "s01_b08",
      "audio_file": "build/audio/s01_b08.wav",
      "duration_seconds": 2.517,
      "subtitle": "और जॉर्जी हमेशा के लिए गायब हो जाता है।"
    },
    {
      "beat_id": "s02_b01",
      "audio_file": "build/audio/s02_b01.wav",
      "duration_seconds": 2.731,
      "subtitle": "कई महीने बाद भी उसका कोई पता नहीं चलता।"
    },
    {
      "beat_id": "s02_b02",
      "audio_file": "build/audio/s02_b02.wav",
      "duration_seconds": 2.752,
      "subtitle": "उसका बड़ा भाई बिल उसे ढूँढना नहीं छोड़ता।"
    },
    {
      "beat_id": "s02_b03",
      "audio_file": "build/audio/s02_b03.wav",
      "duration_seconds": 4.011,
      "subtitle": "डेरी में दूसरे बच्चे भी रहस्यमय तरीके से गायब होने लगते हैं।"
    },
    {
      "beat_id": "s02_b04",
      "audio_file": "build/audio/s02_b04.wav",
      "duration_seconds": 3.797,
      "subtitle": "इसी दौरान बिल अपने कुछ दोस्तों के साथ लूजर्स क्लब बनाता है।"
    },
    {
      "beat_id": "s02_b05",
      "audio_file": "build/audio/s02_b05.wav",
      "duration_seconds": 2.88,
      "subtitle": "बेन, माइक और बेवर्ली भी उनके दोस्त बन जाते हैं।"
    },
    {
      "beat_id": "s02_b06",
      "audio_file": "build/audio/s02_b06.wav",
      "duration_seconds": 4.267,
      "subtitle": "लेकिन जल्द ही सभी को अजीब और डरावनी चीज़ें दिखाई देने लगती हैं।"
    },
    {
      "beat_id": "s02_b07",
      "audio_file": "build/audio/s02_b07.wav",
      "duration_seconds": 4.437,
      "subtitle": "क्योंकि एक डरावना जोकर हर बच्चे के डर का फायदा उठा रहा होता है।"
    },
    {
      "beat_id": "s03_b01",
      "audio_file": "build/audio/s03_b01.wav",
      "duration_seconds": 3.755,
      "subtitle": "बेन को शहर के पुराने रिकॉर्ड में एक डरावना सच मिलता है।"
    },
    {
      "beat_id": "s03_b02",
      "audio_file": "build/audio/s03_b02.wav",
      "duration_seconds": 3.797,
      "subtitle": "हर सत्ताईस साल में बच्चों के गायब होने की घटनाएँ लौटती हैं।"
    },
    {
      "beat_id": "s03_b03",
      "audio_file": "build/audio/s03_b03.wav",
      "duration_seconds": 3.733,
      "subtitle": "बेवर्ली को भी अपने बाथरूम में भयानक खून दिखाई देता है।"
    },
    {
      "beat_id": "s03_b04",
      "audio_file": "build/audio/s03_b04.wav",
      "duration_seconds": 3.072,
      "subtitle": "लेकिन उसके पिता को वहाँ कुछ भी दिखाई नहीं देता।"
    },
    {
      "beat_id": "s03_b05",
      "audio_file": "build/audio/s03_b05.wav",
      "duration_seconds": 4.096,
      "subtitle": "तभी बच्चों को समझ आता है कि इन घटनाओं के पीछे वही जोकर है।"
    },
    {
      "beat_id": "s03_b06",
      "audio_file": "build/audio/s03_b06.wav",
      "duration_seconds": 2.752,
      "subtitle": "उनका शक एक सुनसान घर पर जाकर रुकता है।"
    },
    {
      "beat_id": "s03_b07",
      "audio_file": "build/audio/s03_b07.wav",
      "duration_seconds": 3.413,
      "subtitle": "जहाँ एक डरावना जोकर उनका इंतज़ार कर रहा होता है।"
    },
    {
      "beat_id": "s04_b01",
      "audio_file": "build/audio/s04_b01.wav",
      "duration_seconds": 2.923,
      "subtitle": "बच्चे हिम्मत करके उस घर के अंदर चले जाते हैं।"
    },
    {
      "beat_id": "s04_b02",
      "audio_file": "build/audio/s04_b02.wav",
      "duration_seconds": 2.752,
      "subtitle": "अंदर अँधेरे कमरों में कुछ भयानक छिपा होता है।"
    },
    {
      "beat_id": "s04_b03",
      "audio_file": "build/audio/s04_b03.wav",
      "duration_seconds": 3.136,
      "subtitle": "अचानक उनके सामने एक डरावनी आकृति आ जाती है।"
