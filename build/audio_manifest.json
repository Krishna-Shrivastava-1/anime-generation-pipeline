    {
      "beat_id": "s03_b09",
      "audio_file": "build/audio/s03_b09.wav",
      "duration_seconds": 3.008,
      "subtitle": "रुद्र किसी अजनबी से कह रहा था, योजना तैयार है।"
    },
    {
      "beat_id": "s03_b10",
      "audio_file": "build/audio/s03_b10.wav",
      "duration_seconds": 2.731,
      "subtitle": "कल सुबह पूरा राज्य भूख से परेशान होगा।"
