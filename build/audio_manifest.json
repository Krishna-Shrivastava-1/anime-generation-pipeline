    {
      "beat_id": "s05_b11",
      "audio_file": "build/audio/s05_b11.wav",
      "duration_seconds": 3.563,
      "subtitle": "आपको क्या लगता है, रानी का उस गुप्त दरवाज़े से क्या रिश्ता था?"
    }
  ]
