    {
      "beat_id": "s04_b05",
      "audio_file": "build/audio/s04_b05.wav",
      "duration_seconds": 2.816,
      "subtitle": "वह दोनों राज्यों के बीच युद्ध करवाना चाहता था।"
    },
    {
      "beat_id": "s04_b06",
      "audio_file": "build/audio/s04_b06.wav",
      "duration_seconds": 2.645,
      "subtitle": "तभी रानी के पैर से एक पत्थर खिसक गया।"
