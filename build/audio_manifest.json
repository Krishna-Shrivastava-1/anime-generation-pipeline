    {
      "beat_id": "s04_b06",
      "audio_file": "build/audio/s04_b06.wav",
      "duration_seconds": 2.731,
      "subtitle": "लेकिन उनका खतरा अभी खत्म नहीं हुआ था।"
    },
    {
      "beat_id": "s04_b07",
      "audio_file": "build/audio/s04_b07.wav",
      "duration_seconds": 4.011,
      "subtitle": "उधर हेनरी नाम का एक गुंडा भी उन्हें लगातार परेशान करता है।"
    },
    {
      "beat_id": "s04_b08",
      "audio_file": "build/audio/s04_b08.wav",
      "duration_seconds": 2.731,
      "subtitle": "धीरे-धीरे उनके बीच भी झगड़े होने लगते हैं।"
