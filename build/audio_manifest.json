    {
      "beat_id": "s02_b08",
      "audio_file": "build/audio/s02_b08.wav",
      "duration_seconds": 3.051,
      "subtitle": "क्योंकि पेनीवाइज हर बच्चे के डर का रूप ले सकता है।"
    },
    {
      "beat_id": "s03_b01",
      "audio_file": "build/audio/s03_b01.wav",
      "duration_seconds": 3.755,
      "subtitle": "बेन को शहर के पुराने रिकॉर्ड में एक डरावना सच मिलता है।"
