    {
      "beat_id": "s05_b01",
      "audio_file": "build/audio/s05_b01.wav",
      "duration_seconds": 3.691,
      "subtitle": "लेकिन जब बेवर्ली गायब हो जाती है, बिल फिर सबको बुलाता है।"
    },
    {
      "beat_id": "s05_b02",
      "audio_file": "build/audio/s05_b02.wav",
      "duration_seconds": 3.691,
      "subtitle": "उसे पता चलता है कि वह जोकर उसे जमीन के नीचे ले गया है।"
